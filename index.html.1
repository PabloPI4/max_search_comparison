<script>
const carousel = document.querySelector('.cmp-carousel');
let currentActiveSlide = null;

const observer = new MutationObserver((mutations) => {
  mutations.forEach((mutation) => {
    if (
      mutation.type === 'attributes' &&
      mutation.attributeName === 'class' &&
      mutation.target.classList.contains('cmp-carousel__item')
    ) {
      const item = mutation.target;

      // Only run when NEW slide becomes active
      if (
        item.classList.contains('cmp-carousel__item--active') &&
        item !== currentActiveSlide
      ) {
        currentActiveSlide = item;

        // Pause all videos
        document.querySelectorAll('.cmp-carousel video').forEach(video => {
          video.pause();
          video.currentTime = 0;
        });

        // Play video in active slide
        const video = item.querySelector('video');
        if (video) {
          video.play().catch(() => {});
        }
      }
    }
  });
});

observer.observe(carousel, {
  attributes: true,
  subtree: true,
  attributeFilter: ['class']
});



// Wait until the DOM is loaded
document.addEventListener("DOMContentLoaded", function () {
  const banner = document.getElementById("gtc26-hero-banner");

